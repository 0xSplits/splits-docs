{
  "name": "splits-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vocs dev",
    "build": "pnpm check && vocs build",
    "preview": "vocs preview",
    "start": "node dist/serve-node.js",
    "check:docs": "node scripts/check-prose.mjs",
    "test:prose": "node --test scripts/ste/*.test.mjs",
    "check": "pnpm check:docs && pnpm test:prose"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "vocs": "2.3.2",
    "waku": "^1.0.0-beta.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "typescript": "^5",
    "unified": "11.0.5",
    "vite": "^8",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@10.28.0"
}
